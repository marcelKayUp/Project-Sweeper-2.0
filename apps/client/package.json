{
  "name": "@neon/client",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev:terminals": "vite --host 127.0.0.1 --port 5176 --strictPort --open /terminals.html",
    "build:terminals": "vite build --config vite.terminals.config.ts",
    "check:terminals": "node scripts/check-terminals.mjs",
    "dev:characters": "vite --host 127.0.0.1 --port 5175 --strictPort --open /characters.html",
    "build:characters": "vite build --config vite.characters.config.ts",
    "check:characters": "node scripts/check-modular-characters.mjs",
    "check:characters:procedural": "node scripts/check-characters.mjs",
    "dev:generator": "vite --host 127.0.0.1 --port 5174 --strictPort --open /generator.html",
    "build:generator": "vite build --config vite.generator.config.ts",
    "check:generator-ui": "node scripts/check-generator.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "capture": "vite build && node scripts/capture-deckung.mjs",
    "capture:aktionspunkte": "vite build && node scripts/capture-aktionspunkte.mjs",
    "capture:schuss": "vite build && node scripts/capture-schuss.mjs",
    "mission:vier": "node scripts/mission-vier.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neon/characters": "workspace:*",
    "@neon/generator": "workspace:*",
    "@babylonjs/core": "9.31.2",
    "@babylonjs/serializers": "9.31.2",
    "@babylonjs/loaders": "9.31.2",
    "@colyseus/sdk": "0.18.5",
    "@neon/sim": "workspace:*",
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "gltf-validator": "2.0.0-dev.3.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
